# Run from ios/:  fastlane <lane>
#   setup  - once: register the bundle ID and create the App Store Connect app (Apple ID + 2FA)
#   beta   - archive and upload a new TestFlight build
#   status - latest TestFlight build number
# Auth for beta/status: an App Store Connect API key when ASC_KEY_ID + ASC_ISSUER_ID are set
# (key file ~/private_keys/AuthKey_<id>.p8), otherwise the Apple ID signed in to Xcode uploads.
default_platform(:ios)
ENV["FASTLANE_ITC_TEAM_NAME"] ||= "Tze Kin Wong" # the Apple ID sees several App Store Connect teams

APP_NAME = "nostalRE"

def asc_key
  return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"] || File.expand_path("~/private_keys/AuthKey_#{ENV['ASC_KEY_ID']}.p8")
  )
end

# fastlane 2.241's create_beta_group sends publicLinkLimitEnabled, which Apple rejects for internal groups
def create_internal_group(app, name)
  body = { data: { type: "betaGroups",
                   attributes: { name: name, isInternalGroup: true, hasAccessToAllBuilds: true },
                   relationships: { app: { data: { id: app.id, type: "apps" } } } } }
  resp = Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", body)
  Array(Spaceship::ConnectAPI::Models.parse(resp.body)).first
end

platform :ios do
  lane :setup do
    produce(app_name: APP_NAME, sku: "nostalre", language: "English", app_version: "0.1.0")
  end

  lane :beta do |options|
    key = asc_key
    sh("cd .. && xcodegen generate -q")
    # ponytail: timestamp build number, always increasing, no state to keep
    build = options[:build] || Time.now.utc.strftime("%Y%m%d%H%M")
    auth = key ? "-authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']} -authenticationKeyPath #{key[:key_filepath]}" : ""
    build_app(
      project: "nostalRE.xcodeproj",
      scheme: "nostalRE",
      configuration: "Release",
      destination: "generic/platform=iOS",
      derived_data_path: "build",
      output_directory: "build/export",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates #{auth} CURRENT_PROJECT_VERSION=#{build}",
      export_xcargs: "-allowProvisioningUpdates #{auth}",
      # without an API key, Xcode's own account uploads during export
      export_options: key ? {} : { destination: "upload", manageAppVersionAndBuildNumber: false }
    )
    if key
      upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true,
                           changelog: options[:changelog])
    end
    UI.success("Uploaded build #{build}; TestFlight lists it after Apple processes it (~5-15 min)")
  end

  # Once (Apple ID session): internal group that receives every build, with you in it; prints build status
  lane :testers do |options|
    email = options[:email] || CredentialsManager::AppfileConfig.try_fetch_value(:apple_id)
    Spaceship::ConnectAPI.login(email, use_portal: false, use_tunes: true)
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    app.get_builds(sort: "-uploadedDate", limit: 5, includes: "buildBetaDetail").each do |b|
      d = b.build_beta_detail
      UI.message("build #{b.version}: #{b.processing_state}, internal #{d&.internal_build_state}, expired #{b.expired}")
    end
    group = app.get_beta_groups.find { |g| g.name == "Me" } ||
            create_internal_group(app, "Me")
    UI.message("group #{group.name} (internal: #{group.is_internal_group})")
    user = Spaceship::ConnectAPI::User.find(email: email).first
    UI.user_error!("#{email} is not an App Store Connect user") unless user
    tester = Array(Spaceship::ConnectAPI::BetaTester.find(email: email)).first
    if tester
      members = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: group.id }).to_models.map(&:email)
      UI.message("tester #{tester.email}: invite #{tester.invite_type}, state #{tester.beta_tester_state}; group members: #{members.inspect}")
      Spaceship::ConnectAPI.post_beta_tester_assignment(beta_group_ids: [group.id], attributes: { email: email, firstName: user.first_name, lastName: user.last_name }) unless members.include?(email)
    else
      Spaceship::ConnectAPI::BetaTester.create(email: email, first_name: user.first_name, last_name: user.last_name, beta_group_ids: [group.id])
    end
    if options[:invite]
      tester = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: group.id }).to_models.find { |t| t.email == email }
      body = { data: { type: "betaTesterInvitations", relationships: {
        app: { data: { type: "apps", id: app.id } },
        betaTester: { data: { type: "betaTesters", id: tester.id } } } } }
      Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaTesterInvitations", body)
      UI.message("invite email sent to #{email}")
    end
    UI.success("#{email} is in group Me; accept the TestFlight invite email on the iPhone")
  end

  lane :status do
    UI.message("latest TestFlight build: #{latest_testflight_build_number(api_key: asc_key)}")
  end
end
